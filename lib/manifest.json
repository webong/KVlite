{
  "format": 1,
  "name": "kvlite",
  "cAbiVersion": 1,
  "driverBundles": [
    {
      "id": "rocksdb",
      "goModule": "github.com/webong/kvlite/drivers/rocksdb",
      "buildTags": ["rocksdb", "kvlite_rocksdb"],
      "native": true,
      "description": "RocksDB driver bundle; requires the packaged RocksDB runtime and notices."
    },
    {
      "id": "leveldb",
      "goModule": "github.com/webong/kvlite/drivers/leveldb",
      "buildTags": ["kvlite_leveldb"],
      "native": false,
      "description": "Pure-Go LevelDB driver bundle."
    }
  ],
  "artifacts": [
    {
      "id": "cli",
      "source": "cmd/kvlite",
      "kind": "executable",
      "releasePath": "bin/kvlite",
      "description": "Owns selected KVLite driver directories and exposes the HTTP and Redis-compatible APIs."
    },
    {
      "id": "c-shared",
      "source": "capi",
      "kind": "c-shared-library",
      "releasePath": "lib/libkvlite.<platform-extension>",
      "publicHeader": "capi/kvlite.h",
      "description": "Embedded FFI library used by thin language wrappers."
    }
  ],
  "bindings": [
    {
      "id": "php",
      "source": "lib/bindings/php",
      "package": "webong/kvlite",
      "transports": ["c-abi", "http"]
    },
    {
      "id": "python",
      "source": "lib/bindings/python",
      "package": "kvlite",
      "transports": ["c-abi", "http"]
    },
    {
      "id": "node",
      "source": "lib/bindings/node",
      "package": "@webong/kvlite",
      "transports": ["c-abi", "http"]
    },
    {
      "id": "rust",
      "source": "lib/bindings/rust",
      "package": "kvlite",
      "transports": ["c-abi"]
    }
  ],
  "targets": {
    "linux-amd64": {
      "library": "libkvlite.so",
      "cli": "kvlite"
    },
    "linux-arm64": {
      "library": "libkvlite.so",
      "cli": "kvlite"
    },
    "darwin-amd64": {
      "library": "libkvlite.dylib",
      "cli": "kvlite"
    },
    "darwin-arm64": {
      "library": "libkvlite.dylib",
      "cli": "kvlite"
    },
    "windows-amd64": {
      "library": "kvlite.dll",
      "cli": "kvlite.exe"
    }
  }
}
