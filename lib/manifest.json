{
  "format": 1,
  "name": "kvlite",
  "cAbiVersion": 1,
  "moduleAbiVersion": 1,
  "moduleManifest": "kvlite-module.json",
  "moduleSearchPaths": ["KVLITE_MODULE_PATH", "KVLITE_HOME/modules", "KVLITE_HOME/drivers"],
  "driverBundles": [
    {
      "id": "rocksdb",
      "goModule": "github.com/webong/kvlite/extensions/rocksdb",
      "sourceManifest": "../extensions/rocksdb/kvlite-module.json",
      "manifest": "kvlite-module.json",
      "buildTags": ["rocksdb", "kvlite_rocksdb"],
      "native": true,
      "description": "RocksDB driver bundle; requires the packaged RocksDB runtime and notices."
    },
    {
      "id": "leveldb",
      "goModule": "github.com/webong/kvlite/extensions/leveldb",
      "sourceManifest": "../extensions/leveldb/kvlite-module.json",
      "manifest": "kvlite-module.json",
      "buildTags": ["kvlite_leveldb"],
      "native": false,
      "description": "Pure-Go LevelDB driver bundle."
    }
  ],
  "extensions": [
    {
      "id": "http",
      "goModule": "github.com/webong/kvlite/extensions/http",
      "sourceManifest": "../extensions/http/kvlite-module.json",
      "description": "Optional JSON/HTTP server and Go remote-client extension. It is linked only by callers that choose it; embedded C bundles do not include it."
    },
    {
      "id": "redis",
      "goModule": "github.com/webong/kvlite/extensions/redis",
      "sourceManifest": "../extensions/redis/kvlite-module.json",
      "description": "Optional Redis-compatible RESP server extension. It is linked only by callers that choose it; embedded C bundles do not include it."
    }
  ],
  "artifacts": [
    {
      "id": "cli",
      "source": "cmd/kvlite",
      "kind": "executable",
      "releasePath": "bin/kvlite",
      "description": "Owns selected KVLite driver directories. Current convenience builds link the optional HTTP and Redis server extensions; standalone protocol artifacts are the next module-loader milestone."
    },
    {
      "id": "c-shared",
      "source": "capi",
      "kind": "c-shared-library",
      "releasePath": "lib/libkvlite.<platform-extension>",
      "publicHeader": "capi/kvlite.h",
      "description": "Embedded FFI library used by thin language wrappers."
    }
  ],
  "bindings": [
    {
      "id": "php",
      "source": "lib/bindings/php",
      "package": "webong/kvlite",
      "transports": ["c-abi", "http", "redis"]
    },
    {
      "id": "python",
      "source": "lib/bindings/python",
      "package": "kvlite",
      "transports": ["c-abi", "http", "redis"]
    },
    {
      "id": "node",
      "source": "lib/bindings/node",
      "package": "@webong/kvlite",
      "transports": ["c-abi", "http", "redis"]
    },
    {
      "id": "rust",
      "source": "lib/bindings/rust",
      "package": "kvlite",
      "transports": ["c-abi", "http", "redis"]
    }
  ],
  "targets": {
    "linux-amd64": {
      "library": "libkvlite.so",
      "cli": "kvlite"
    },
    "linux-arm64": {
      "library": "libkvlite.so",
      "cli": "kvlite"
    },
    "darwin-amd64": {
      "library": "libkvlite.dylib",
      "cli": "kvlite"
    },
    "darwin-arm64": {
      "library": "libkvlite.dylib",
      "cli": "kvlite"
    },
    "windows-amd64": {
      "library": "kvlite.dll",
      "cli": "kvlite.exe"
    }
  }
}
